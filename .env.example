# ==============================================================================
# Volt OS Django Backend (VPS: https://app.voltos.techtrendo.com)
# & Unified Frontend (Vercel: https://www.voltos.techtrendo.com)
# Copy into `.env` on your VPS / Vercel Project Settings (never commit secrets).
# ==============================================================================

# --- ERP Frontend Build Vars (set in Vercel Project Settings) ---
VITE_USE_MOCK=false
VITE_API_BASE_URL=https://app.voltos.techtrendo.com/api
VITE_STOREFRONT_URL=https://www.voltos.techtrendo.com
VITE_ERP_BASE_PATH=/erp

# --- Django Backend Core (set in VPS /opt/voltos/backend/.env) ---
DJANGO_SECRET_KEY=replace-with-strong-64-char-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.voltos.techtrendo.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://www.voltos.techtrendo.com,https://voltos.techtrendo.com
CSRF_TRUSTED_ORIGINS=https://app.voltos.techtrendo.com,https://www.voltos.techtrendo.com,https://voltos.techtrendo.com
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- PostgreSQL Database on VPS ---
DB_NAME=voltnepal_db
DB_USER=postgres
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Bidirectional ERP <-> Storefront Sync ---
STOREFRONT_URL=https://www.voltos.techtrendo.com
CMS_WEBHOOK_SECRET=replace-with-strong-shared-hmac-secret
STOREFRONT_ENQUIRY_API_KEY=replace-with-strong-shared-enquiry-api-key
STOREFRONT_ENQUIRY_HMAC_SECRET=replace-with-strong-shared-hmac-secret

# --- Email (SMTP for enquiry confirmations & staff notifications) ---
DEFAULT_FROM_EMAIL=Volt OS Nepal <no-reply@voltos.techtrendo.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Optional Cloudinary Media Storage ---
# Leave empty to serve uploads from VPS Nginx (/media/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
