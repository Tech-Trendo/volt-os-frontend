# ==============================================================================
# Volt OS Unified Vercel Project (Storefront + ERP SPA) Environment Example
# Production Domain: https://www.voltos.techtrendo.com
# ERP Login URL:     https://www.voltos.techtrendo.com/auth/login
# Backend VPS API:   https://app.voltos.techtrendo.com/api
# ==============================================================================

# --- Production (Vercel) ---
# ERP_API_BASE_URL="https://app.voltos.techtrendo.com/api"
# ERP_PUBLIC_ORIGIN="https://app.voltos.techtrendo.com"
# VITE_API_BASE_URL="https://app.voltos.techtrendo.com/api"
# ERP_FRONTEND_URL="/erp"
# NEXTAUTH_URL="https://www.voltos.techtrendo.com"

# --- Local Development ---
ERP_API_BASE_URL="http://127.0.0.1:8000/api"
ERP_PUBLIC_ORIGIN="http://127.0.0.1:8000"
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
ERP_FRONTEND_URL="/erp"
NEXTAUTH_URL="http://localhost:3001"

# Shared Secrets with Django ERP VPS (must match backend .env exactly)
STOREFRONT_ENQUIRY_API_KEY="replace-with-strong-shared-enquiry-api-key"
STOREFRONT_ENQUIRY_HMAC_SECRET="replace-with-strong-shared-hmac-secret"
CMS_WEBHOOK_SECRET="replace-with-strong-shared-hmac-secret"

# NextAuth Secret (32+ random characters)
NEXTAUTH_SECRET="replace-with-a-strong-32-char-random-secret-key"
